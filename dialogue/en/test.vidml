<?xml version="1.0" encoding="utf-8"?>
<vidml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <head>
    <sprite name = "icosprite" src = "res://icon.svg" width = "300" height = "250"/>
    <sfx name="gstr" src="res://dialogue/sfx/snd_wngdng1.wav" volume="0.0" />
    <soundboard name = "sans-soundboard">
      <sound src = "res://dialogue/sfx/snd_txtsans.wav" />
    </soundboard>
    <soundboard name = "gaster">
      <sound src = "res://dialogue/sfx/snd_wngdng1.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng2.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng3.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng4.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng5.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng6.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng7.wav"/>
    </soundboard>
    <soundboard name = "gaster-rand" order="random">
      <sound src = "res://dialogue/sfx/snd_wngdng1.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng2.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng3.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng4.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng5.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng6.wav"/>
      <sound src = "res://dialogue/sfx/snd_wngdng7.wav"/>
    </soundboard>
    <sprite-collection name = "sans" default = "default">
      <sprite name = "default"  src = "res://dialogue/images/sansundertale.png" width = "200" height = "200"/>
    </sprite-collection>

    <style name="sans_text" char-speed="20" color="#FFFFFF" dialogue-box = "normal-box" sprite-collection = "sans" 
    sprite-pos-x="50" sprite-pos-y="40" 
    text-pos-x="300" text-pos-y="60"
    text-align = "left"
    opacity = "1"
    font-size = "50"
    font = "res://dialogue/en/fonts/Comic Sans.ttf"
    vertical-spacing = "10"
    text-width = "800"
    text-height = "300"
    soundboard = "sans-soundboard"
    />
    <text-box name = "normal-box" src = "res://dialogue/en/basic_window.png" width = "1200" height = "300"/>
  </head>
  <body>
    <conv uid="intro_conversation"  style = "sans_text">
      <phrase>
        This... [pause="1.0"] this is a pause
      </phrase> 
    </conv>
  </body>
</vidml>