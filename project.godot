;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ViDML_csharp"
run/main_scene="uid://bvryrs1r26yh8"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ViDMLManager="*uid://dnf84iw04qmq"

[display]

window/size/viewport_width=1174
window/size/viewport_height=758
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="ViDML_csharp"

[physics]

